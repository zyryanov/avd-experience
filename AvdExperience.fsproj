<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>avd-experience</AssemblyName>
    <RootNamespace>avd_experience</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Aleksei Zyrianov</Authors>
    <Description>AVD session log analyzer — active time, lost time, disruption cost</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- PublishTrimmed silently sets this to false, breaking the runtime
         JsonSerializer.Deserialize<string list> call in DbRepository.toLogEvent. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Elevation.fs" />
    <Compile Include="ServiceManager.fs" />
    <Compile Include="CsvExport.fs" />
    <Compile Include="Report.fs" />
    <Compile Include="MonitorWatcher.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="AvdExperience.Core\AvdExperience.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>
</Project>